# Copy to .env and fill in your values. Never commit .env.
#
#   cp .env.example .env
#
# Step 1 model: edit MODEL_ID in inference_101.py (not here).

# Hugging Face Hub — https://huggingface.co/settings/tokens
# Used by inference_101.py, transformers downloads, gated models.
HF_TOKEN=
# Optional — some HF tooling exposes fine-grained tokens in this shape:
# HF_ACCESS_KEY_ID=
# HF_SECRET_ACCESS_KEY=

# Modal (Mac / no local GPU): https://modal.com/settings
# Then: bash scripts/setup_modal.sh
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Modal apps: bash scripts/modal.sh deploy all

# Optional docker compose / client overrides
# TARGET_URL=http://127.0.0.1:8000/v1
# OPENAI_BASE_URL=http://127.0.0.1:8080/v1
# NAIVE_SERVER_URL=http://naive-server:8000/v1
